# =============================================================================
# Ayam Counter Dashboard (Next.js) — image produksi
#
# Build (dari root project /home/z/my-project):
#   docker build -f deploy/docker/Dockerfile.web -t ayam-web .
#
# Build dengan backend di container terpisah (docker compose):
#   BACKEND_ORIGIN di-bake saat build → compose mengirim build arg otomatis.
#
# Jalankan:
#   docker run -p 3000:3000 -v ayam-db:/app/db -e DATABASE_URL=file:/app/db/custom.db ayam-web
# =============================================================================

# syntax=docker/dockerfile:1

# ---------- STAGE 1: dependencies ----------
FROM node:22-alpine AS deps
WORKDIR /app

# libc6-compat: dibutuhkan native binding (SWC/oxide) di atas musl/Alpine.
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
COPY patches ./patches
COPY prisma ./prisma

# npm ci → versi dependency identik dengan package-lock.json.
# Postinstall menjalankan patch-package (patch @tailwindcss/oxide).
RUN npm ci

# ---------- STAGE 2: build ----------
FROM node:22-alpine AS builder
WORKDIR /app

RUN apk add --no-cache libc6-compat

# Origin backend Flask DI-BAKE saat build (standalone Next men-serialize config).
# Default dev/native  : http://127.0.0.1:5000
# Docker compose      : http://backend:5000  (di-set lewat compose build args)
ARG BACKEND_ORIGIN=http://127.0.0.1:5000
ENV BACKEND_ORIGIN=${BACKEND_ORIGIN} \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npx prisma generate \
 && npm run build

# ---------- STAGE 3: runtime ----------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1 \
    DATABASE_URL=file:/app/db/custom.db

RUN addgroup --system --gid 1001 ayam \
 && adduser --system --uid 1001 ayam \
 && mkdir -p /app/db /app/data \
 && chown -R ayam:ayam /app

# `.next/standalone` sudah berisi server.js + node_modules minimal;
# script `npm run build` project juga sudah menyalin .next/static & public
# ke dalam standalone, sehingga cukup satu COPY.
COPY --from=builder --chown=ayam:ayam /app/.next/standalone ./

USER ayam

EXPOSE 3000
VOLUME ["/app/db"]

# Node menjalankan server.js standalone Next.js
CMD ["node", "server.js"]
