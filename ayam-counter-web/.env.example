# ============================================
# AYAM COUNTER WEB - CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and customize for your deployment

# ============================================
# CAMERA SETTINGS
# ============================================
CAMERA_SOURCE=0          # 0 for webcam, or RTSP URL string
CAMERA_FPS=8             # Camera frame rate
CAMERA_WIDTH=640         # Camera resolution width
CAMERA_HEIGHT=480        # Camera resolution height

# ============================================
# YOLO MODEL SETTINGS
# ============================================
YOLO_MODEL_PATH=models/best_shackle.pt
CONFIDENCE_THRESHOLD=0.25
YOLO_IMGSZ=(224, 128)    # Input size (width, height)

# ============================================
# HARDWARE ACCELERATION
# ============================================
# Device preference order: auto | cuda | openvino | dml | cpu
# - auto: Automatically detect (CUDA > IGPU > CPU) - RECOMMENDED
# - cuda: Force NVIDIA GPU (RTX 3060 Ti recommended)
# - openvino: Use Intel/AMD integrated GPU via OpenVINO
# - dml: Use DirectML backend (Windows only)
# - cpu: Force CPU inference (slowest but always available)
DEVICE=auto

# Enable hardware benchmarking at startup
HW_BENCHMARK=enabled

# ============================================
# COUNTER SETTINGS
# ============================================
COUNT_LINE_X=50          # Count line position (pixels from left)
ZONE_WIDTH=20            # Detection zone width (pixels)

# ============================================
# FLASK SETTINGS
# ============================================
FLASK_ENV=development
SECRET_KEY=change-this-in-production-please
CORS_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=15
HISTORY_MAX_LIMIT=500
EXPORT_MAX_RANGE_DAYS=366
PIN_MAX_ATTEMPTS=5
PIN_LOCK_SECONDS=60
RECONNECT_INITIAL_SECONDS=1
RECONNECT_MAX_SECONDS=30
